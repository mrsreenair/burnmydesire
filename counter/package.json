{
  "name": "burnmydesire-counter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Anonymous world counter for Burn My Desire, on Cloudflare Workers + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply burnmydesire-counter --remote",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --test test/*.test.js",
    "test:worker": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
